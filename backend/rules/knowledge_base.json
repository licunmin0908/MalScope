{
  "version": "1.0.0",
  "description": "MalScope 安全知识库：可疑 API 分类、加壳器特征、恶意字符串规则、行为-ATT&CK 映射。",
  "suspicious_apis": {
    "process_injection": {
      "level": "high",
      "description": "进程注入（远程写入、创建远程线程、APC 注入、进程镂空）",
      "attack": "T1055",
      "apis": ["VirtualAllocEx", "WriteProcessMemory", "ReadProcessMemory", "CreateRemoteThread", "CreateRemoteThreadEx", "NtCreateThreadEx", "RtlCreateUserThread", "QueueUserAPC", "NtQueueApcThread", "SetThreadContext", "GetThreadContext", "Wow64SetThreadContext", "NtMapViewOfSection", "ZwMapViewOfSection", "NtUnmapViewOfSection", "NtWriteVirtualMemory", "NtReadVirtualMemory", "NtAllocateVirtualMemory", "VirtualProtectEx", "OpenProcess", "NtOpenProcess", "NtResumeThread", "SetWindowsHookEx", "UnhookWindowsHookEx"]
    },
    "memory_manipulation": {
      "level": "high",
      "description": "内存操作（动态申请可执行内存、修改内存属性，常见于脱壳/Shellcode 执行）",
      "attack": "T1055",
      "apis": ["VirtualAlloc", "VirtualProtect", "HeapCreate", "HeapAlloc", "NtProtectVirtualMemory", "ZwProtectVirtualMemory", "RtlMoveMemory", "MapViewOfFile", "CreateFileMappingW", "CreateFileMappingA", "NtCreateSection", "UpdateResource", "LoadLibraryA", "GetProcAddress"]
