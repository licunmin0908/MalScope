    "dynamic_resolution": {
      "level": "medium",
      "description": "动态解析/运行时加载（规避静态导入表检测，常见于加壳与混淆）",
      "attack": "T1027.007",
      "apis": ["LoadLibraryExA", "LoadLibraryExW", "LdrLoadDll", "LdrGetProcedureAddress", "GetModuleHandleA", "GetModuleHandleW", "RtlDecompressBuffer"]
    }
  },
