  "packer_heuristics": {"high_entropy_threshold": 7.2, "tiny_import_dll_threshold": 3, "tiny_import_func_threshold": 15},
  "string_patterns": [
    {"name": "url", "regex": "\\b(?:https?|ftp|tcp|udp|ws|wss)://[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=%]{4,2048}", "level": "medium", "desc": "URL 地址（可能为 C2 或下载源）"},
    {"name": "ipv4", "regex": "\\b(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\b", "level": "medium", "desc": "IPv4 地址"},
    {"name": "domain", "regex": "\\b(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?\\.)+(?:com|net|org|cn|ru|top|xyz|info|biz|io|cc|tk|ml|ga|gq|pw|onion|su|me|club|online|site|space|live|icu|shop|vip)\\b", "level": "medium", "desc": "域名"},
    {"name": "email", "regex": "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b", "level": "low", "desc": "邮箱地址"},
    {"name": "windows_path", "regex": "(?:[A-Za-z]:\\\\|\\\\\\\\\\?\\\\|\\\\\\\\)(?:[^\\\\/:*?\"<>|\\r\\n]{1,255}\\\\)*[^\\\\/:*?\"<>|\\r\\n]{1,255}", "level": "low", "desc": "Windows 文件路径"},
    {"name": "registry_key", "regex": "(?:HKEY_[A-Z_]+|HKLM|HKCU|HKCR|HKU|HKCC)\\\\[A-Za-z0-9_\\\\ .\\-{}/]{3,255}", "level": "medium", "desc": "注册表路径"},
    {"name": "useragent", "regex": "Mozilla/[45]\\.0 \\([^)]+\\)[^\\r\\n]{0,200}", "level": "low", "desc": "User-Agent 指纹"},
    {"name": "cmdline", "regex": "(?:cmd(?:\\.exe)?\\s+/c|powershell(?:\\.exe)?\\s+|wscript(?:\\.exe)?\\s+|cscript(?:\\.exe)?\\s+|mshta(?:\\.exe)?\\s+|rundll32(?:\\.exe)?\\s+|regsvr32(?:\\.exe)?\\s+|bitsadmin\\s+|certutil\\s+)[^\\r\\n]{0,500}", "level": "high", "desc": "可疑命令行/脚本宿主调用"},
    {"name": "mutex", "regex": "(?:Global|Local)\\\\[A-Za-z0-9_\\-{}.]{4,128}", "level": "medium", "desc": "互斥体名称（常作为感染标记）"},
    {"name": "base64_blob", "regex": "(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{40,}={0,2}(?![A-Za-z0-9+/])", "level": "medium", "desc": "疑似 Base64 编码数据块"},
    {"name": "rsa_key_marker", "regex": "-----BEGIN (?:RSA )?(?:PUBLIC|PRIVATE) KEY-----", "level": "high", "desc": "内嵌 RSA 公私钥（勒索/后门常用）"},
    {"name": "btc_wallet", "regex": "\\b(?:bc1[a-z0-9]{25,39}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\\b", "level": "high", "desc": "比特币钱包地址（勒索赎金特征）"},
    {"name": "ransom_note", "regex": "(?i)(your files have been encrypted|all your files|decrypt.{0,30}(bitcoin|payment)|recover your files)", "level": "critical", "desc": "勒索信文本特征"},
    {"name": "powershell_enc", "regex": "(?i)powershell(?:\\.exe)?[^\\r\\n]{0,80}(?:-enc|-e |-encodedcommand|frombase64string)", "level": "high", "desc": "PowerShell 编码命令（常见于无文件攻击）"},
    {"name": "persistence_run", "regex": "(?i)Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run(?:Once)?", "level": "high", "desc": "自启动注册表键"}
  ],
