      "apis": ["CreateServiceA", "CreateServiceW", "OpenSCManagerA", "OpenSCManagerW", "OpenServiceA", "OpenServiceW", "StartServiceA", "StartServiceW", "ChangeServiceConfigA", "ChangeServiceConfigW", "ControlService", "NetScheduleJobAdd", "SchRpcRegisterTask", "CopyFileA", "CopyFileW", "MoveFileExA", "MoveFileExW", "MoveFileWithProgressW", "WriteFile", "SHFileOperationW", "SetFileAttributesW"]
