      "attack": "T1497",
      "apis": ["GetSystemFirmwareTable", "EnumSystemFirmwareTables", "GetAdaptersInfo", "GetAdaptersAddresses", "SetupDiGetDeviceRegistryPropertyW", "GetVolumeInformationW", "GetDiskFreeSpaceExW", "GlobalMemoryStatusEx", "GetSystemInfo", "GetComputerNameW", "GetUserNameW", "EnumWindows", "GetForegroundWindow", "GetCursorPos", "GetSystemMetrics", "CreateToolhelp32Snapshot", "Process32FirstW", "Process32NextW"]
    },
    "network_c2": {
