      "attack": "T1134",
      "apis": ["AdjustTokenPrivileges", "OpenProcessToken", "OpenThreadToken", "DuplicateTokenEx", "ImpersonateLoggedOnUser", "SetTokenInformation", "LookupPrivilegeValueA", "LookupPrivilegeValueW", "AllocateAndInitializeSid", "CreateProcessAsUserW", "LogonUserA", "LogonUserW", "SetThreadToken", "CreateProcessWithLogonW"]
