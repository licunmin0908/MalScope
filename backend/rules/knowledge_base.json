      "attack": "T1021",
      "apis": ["WNetAddConnection2A", "WNetAddConnection2W", "NetUseAdd", "NetShareAdd", "NetSessionEnum", "NetLocalGroupGetMembers", "IcmpSendEcho", "DnsQuery_A"]
    },
    "crypto": {
      "level": "medium",
