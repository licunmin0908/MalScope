      "level": "high",
      "description": "反调试（检测调试器、时间差检测、异常处理反调试）",
      "attack": "T1622",
      "apis": ["IsDebuggerPresent", "CheckRemoteDebuggerPresent", "NtQueryInformationProcess", "OutputDebugStringA", "OutputDebugStringW", "GetTickCount", "GetTickCount64", "QueryPerformanceCounter", "NtSetInformationThread", "NtQueryObject", "NtQuerySystemInformation", "SetUnhandledExceptionFilter", "RaiseException", "RtlAddVectoredExceptionHandler", "AddVectoredExceptionHandler", "ZwQueryInformationProcess", "DebugActiveProcess", "NtClose"]
    },
