# ================= MalScope 后端配置模板 =================
# 复制为 .env 后按需修改

# ---- 应用 ----
APP_NAME=MalScope 恶意软件样本智能分析平台
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- 数据库 ----
# 生产：MySQL 8.0；不配置时自动回退到本地 SQLite，保证开箱可运行
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/malscope?charset=utf8mb4
DB_ECHO=false

# ---- Redis / 任务队列 ----
# USE_CELERY=true 时需要 Redis；否则使用进程内后台任务（本机演示友好）
REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=false

# ---- 安全（生产环境务必替换）----
SECRET_KEY=please-change-this-to-a-long-random-secret-string-32bytes+
ACCESS_TOKEN_EXPIRE_MINUTES=720
# AES-256 样本加密主密钥（base64 编码 32 字节）；留空则由 SECRET_KEY 派生
AES_MASTER_KEY=

# ---- 上传与存储限制 ----
MAX_UPLOAD_SIZE=104857600
MAX_EXTRACTED_SIZE=524288000
MAX_ARCHIVE_ENTRIES=1000

# ---- 沙箱 ----
# 可选：virtualbox / libvirt / mock（本机无虚拟机时用 mock 演示完整流程）
SANDBOX_DRIVER=mock
SANDBOX_VM_NAME=MALSCOPE_WIN10
SANDBOX_SNAPSHOT=clean_base
SANDBOX_TIMEOUT=120
SANDBOX_DISABLE_NETWORK=true

# ---- 威胁情报 ----
VIRUSTOTAL_API_KEY=
MISP_URL=
MISP_API_KEY=
